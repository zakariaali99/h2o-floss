# Copy to .env — every value here has a working dev default in config/settings/base.py
DEBUG=1
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
TIME_ZONE=Africa/Tripoli
LANGUAGE_CODE=ar
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Storefront business config (surfaced through /api/v1/config/)
CURRENCY=LYD
FREE_SHIPPING=1
SUPPORT_WHATSAPP=
